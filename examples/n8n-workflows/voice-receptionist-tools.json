        "additionalFields": {
          "summary": "=Consultation: {{ $json.body.name }}",
          "description": "=Booked by the AI receptionist.\\nPhone: {{ $json.body.phone }}\\nNotes: {{ $json.body.notes || 'none' }}"
        }
      },
      "id": "5e32cdee-abc5-41af-97bf-1e0d1be21cbe",
      "name": "Create calendar event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
