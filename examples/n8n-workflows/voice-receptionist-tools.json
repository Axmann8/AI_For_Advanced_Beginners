        "responseBody": "={{ { booked: true, eventId: $json.id, message: `You're booked for ${$('Book appointment webhook').first().json.body.start}. See you then!` } }}",
        "options": {}
      },
      "id": "83697ab1-d61b-41df-9916-6d9fdc528520",
      "name": "Confirm booking",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
