        },
        "returnAll": true,
        "timeMin": "={{ $json.body.date }}T00:00:00",
        "timeMax": "={{ $json.body.date }}T23:59:59",
        "options": {}
      },
      "id": "3ef1d786-b1af-4f60-9866-6f7238c6195f",
      "name": "Get that day's events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Settings: your business hours (24h clock) and your timezone offset from UTC\nconst OPEN = 9, CLOSE = 17, SLOT_MINUTES = 30, TZ_OFFSET = '+00:00';\n\n// Find free 30-minute slots on a given day, inside business hours, avoiding existing events.\nfunction freeSlots(dateStr, events, { open = 9, close = 17, minutes = 30, tzOffset = \"+00:00\" } = {}) {\n  const day = new Date(`${dateStr}T00:00:00${tzOffset}`);\n  const busy = events\n    .map((e) => [new Date(e.start.dateTime || e.start.date), new Date(e.end.dateTime || e.end.date)])\n    .sort((a, b) => a[0] - b[0]);\n  const slots = [];\n  for (let t = new Date(day.getTime() + open * 3600e3); t.getTime() + minutes * 60e3 <= day.getTime() + close * 3600e3; t = new Date(t.getTime() + minutes * 60e3)) {\n    const end = new Date(t.getTime() + minutes * 60e3);\n    if (!busy.some(([s, e]) => t < e && end > s)) slots.push(t.toISOString());\n  }\n  return slots;\n}\n\nconst date = $('Check availability webhook').first().json.body.date; // e.g. \"2026-10-01\"\nconst events = $input.all().map((i) => i.json).filter((e) => e.start);\nconst slots = freeSlots(date, events, { open: OPEN, close: CLOSE, minutes: SLOT_MINUTES, tzOffset: TZ_OFFSET });\nconst spoken = slots.slice(0, 4).map((s) => new Date(s).toISOString().slice(11, 16));\nreturn [{ json: {\n  date,\n  available: slots.length > 0,\n  slots,\n  message: slots.length\n    ? `On ${date} I have openings at ${spoken.join(', ')}${slots.length > 4 ? ' and a few more' : ''}.`\n    : `Sorry, ${date} is fully booked. Would another day work?`,\n} }];\n"
      },
      "id": "ca731a4f-e444-4cbd-9a54-1fa9c07861e4",
      "name": "Find free slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "66516b39-18c2-4271-b65c-5f4d02f499a7",
      "name": "Reply with slots",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
