      "id": "905155f9-e356-4f52-b8cc-99c69e16be7d",
      "name": "Keep top 15",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Squash the RSS items into one numbered list the AI can read\nconst lines = $input.all().map((item, i) => {\n  const { title, link, contentSnippet } = item.json;\n  return `${i + 1}. ${title}\\n${(contentSnippet || '').slice(0, 300)}\\n${link}`;\n});\nreturn [{ json: { articles: lines.join('\\n\\n'), count: lines.length } }];"
      },
      "id": "5ec25e49-09b8-433f-bb99-94c78269329a",
      "name": "Build article list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are my upbeat tech-news friend. From these {{ $json.count }} stories, pick the 5 most interesting for someone learning to build with AI (MCP, agents, automation, new tools).\n\nFor each: a punchy one-line headline, one sentence on why it matters, and the link. End with one \"try this today\" idea.\n\nFormat for Slack (use *bold*, no markdown headers).\n\nStories:\n{{ $json.articles }}"
      },
      "id": "6e1ba511-838d-4711-bc34-c7a2ef43362f",
      "name": "Summarize with Claude",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5"
        },
        "options": {
          "maxTokensToSample": 1500
        }
      },
      "id": "e59106b9-679d-4608-9084-c477331bc120",
      "name": "Claude",
